ALLTECH_ENV=development
ALLTECH_SECRET_KEY=replace-with-at-least-50-random-characters
# Use a separate long random value in production to encrypt sensitive fields.
ALLTECH_FIELD_ENCRYPTION_KEY=replace-with-a-different-long-random-value
ALLTECH_ALLOWED_HOSTS=localhost,127.0.0.1
ALLTECH_CSRF_TRUSTED_ORIGINS=http://localhost:8000
ALLTECH_TIME_ZONE=Africa/Nairobi
ALLTECH_ENFORCE_STAFF_ROLES=0
ALLTECH_REQUIRE_STAFF_2FA=0

# Transaction reliability
# Pending checkout stock is held for this many minutes before automatic cancellation.
# The default 1440 equals 24 hours; reduce only after aligning customer payment operations.
# ALLTECH_ORDER_RESERVATION_MINUTES=1440

# Customer order communication
# Confirmation emails are sent only after checkout commits successfully.
# ALLTECH_ORDER_CUSTOMER_EMAILS_ENABLED=1
# Customer-visible order status events can send email updates.
# ALLTECH_ORDER_STATUS_EMAILS_ENABLED=1
# Optional completed-order review requests. Keep disabled until SMTP delivery is verified.
# ALLTECH_ORDER_REVIEW_EMAILS_ENABLED=0

# Durable automation
# ALLTECH_AUTOMATION_JOB_MAX_ATTEMPTS=5
# ALLTECH_AUTOMATION_HTTP_TIMEOUT_SECONDS=20
# Keep disabled until the Meta app, Page permissions and long-lived Page token are verified.
# ALLTECH_META_AUTO_PUBLISH_ENABLED=0
# Set the Graph API version supported by the connected Meta app.
# ALLTECH_META_GRAPH_VERSION=v23.0
# ALLTECH_META_PAGE_ID=
# ALLTECH_META_INSTAGRAM_ACCOUNT_ID=
# Store the Page access token only in the protected production .env file.
# ALLTECH_META_PAGE_ACCESS_TOKEN=

# Private files and backups
# ALLTECH_PRIVATE_MEDIA_ROOT=/home/admin/All-tech-hub/private_media
# ALLTECH_PRIVATE_MEDIA_USE_X_ACCEL=1
# ALLTECH_BACKUP_ROOT=/home/admin/All-tech-hub/backups
# Optional existing rclone remote for encrypted/off-site backup copies.
# ALLTECH_BACKUP_RCLONE_DEST=secure-remote:leosoft-production-backups

# PostgreSQL production example
# ALLTECH_DB_ENGINE=django.db.backends.postgresql
# ALLTECH_DB_NAME=alltech
# ALLTECH_DB_USER=alltech
# ALLTECH_DB_PASSWORD=replace-me
# ALLTECH_DB_HOST=127.0.0.1
# ALLTECH_DB_PORT=5432
# ALLTECH_DB_CONN_MAX_AGE=60

# SMTP
# ALLTECH_EMAIL_HOST=smtp.example.com
# ALLTECH_EMAIL_PORT=587
# ALLTECH_EMAIL_USER=
# ALLTECH_EMAIL_PASSWORD=
# ALLTECH_DEFAULT_FROM_EMAIL=no-reply@example.com
# ALLTECH_EMAIL_USE_TLS=1

# Product image enhancement, watermarking and responsive delivery
# Conservative defaults preserve aspect ratio and real product colours.
# ALLTECH_PRODUCT_IMAGE_WATERMARK_ENABLED=1
# ALLTECH_PRODUCT_IMAGE_ENHANCEMENT_ENABLED=1
# ALLTECH_PRODUCT_IMAGE_ARCHIVE_ORIGINALS=1
# ALLTECH_PRODUCT_IMAGE_WATERMARK_TEXT="LEOSOFT UG LTD • leosoftug.com"
# ALLTECH_PRODUCT_IMAGE_WATERMARK_OPACITY=58
# ALLTECH_PRODUCT_IMAGE_WATERMARK_MAX_WIDTH=1800
# ALLTECH_PRODUCT_IMAGE_MAX_BRIGHTNESS_GAIN=1.06
# ALLTECH_PRODUCT_IMAGE_MAX_CONTRAST_GAIN=1.04
# ALLTECH_PRODUCT_IMAGE_SHARPEN_PERCENT=35
# Generate proportional WebP sizes for cards and detail pages.
# ALLTECH_PRODUCT_IMAGE_RESPONSIVE_ENABLED=1
# ALLTECH_PRODUCT_IMAGE_RESPONSIVE_WIDTHS=320,640,960,1280
# ALLTECH_PRODUCT_IMAGE_RESPONSIVE_QUALITY=84

# Production HTTPS
# ALLTECH_SECURE_SSL_REDIRECT=1
# ALLTECH_SECURE_HSTS_SECONDS=31536000
# ALLTECH_SECURE_HSTS_PRELOAD=1

# Browser security headers
# ALLTECH_SECURITY_HEADERS_ENABLED=1
# ALLTECH_REFERRER_POLICY=same-origin
# ALLTECH_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=()
# ALLTECH_CSP_REPORT_ONLY=1
# ALLTECH_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net; img-src 'self' data: blob:; font-src 'self' https://cdn.jsdelivr.net data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'

# LEOSOFT UG LTD production environment
# Copy this file to the repository root as .env and replace every placeholder.
# Keep .env outside version control and readable only by the deployment user.

ALLTECH_ENV=production
ALLTECH_SECRET_KEY=replace-with-a-random-secret-key-of-at-least-50-characters
ALLTECH_ALLOWED_HOSTS=leosoftug.com,www.leosoftug.com
ALLTECH_CSRF_TRUSTED_ORIGINS=https://leosoftug.com,https://www.leosoftug.com
ALLTECH_TIME_ZONE=Africa/Kampala
ALLTECH_LOG_LEVEL=INFO

# PostgreSQL. Use a database and role dedicated to this application.
ALLTECH_DB_ENGINE=django.db.backends.postgresql
ALLTECH_DB_NAME=leosoft_prod
ALLTECH_DB_USER=leosoft_user
ALLTECH_DB_PASSWORD=replace-with-a-strong-database-password
ALLTECH_DB_HOST=127.0.0.1
ALLTECH_DB_PORT=5432
ALLTECH_DB_CONN_MAX_AGE=60

# Production access controls
ALLTECH_ENFORCE_STAFF_ROLES=1
ALLTECH_REQUIRE_STAFF_2FA=1

# HTTPS and browser security
ALLTECH_SECURE_SSL_REDIRECT=1
ALLTECH_SECURE_HSTS_SECONDS=31536000
ALLTECH_SECURE_HSTS_PRELOAD=1
ALLTECH_SECURITY_HEADERS_ENABLED=1
ALLTECH_REFERRER_POLICY=same-origin
ALLTECH_PERMISSIONS_POLICY=camera=(),microphone=(),geolocation=(),payment=()
# Keep CSP in report-only mode until browser testing confirms that all pages work.
ALLTECH_CSP_REPORT_ONLY=1

# SMTP. Leave ALLTECH_EMAIL_HOST blank until a real provider is configured.
ALLTECH_EMAIL_HOST=
ALLTECH_EMAIL_PORT=587
ALLTECH_EMAIL_USER=
ALLTECH_EMAIL_PASSWORD=
ALLTECH_DEFAULT_FROM_EMAIL="LEOSOFT UG LTD <no-reply@leosoftug.com>"
ALLTECH_EMAIL_USE_TLS=1
ALLTECH_EMAIL_USE_SSL=0

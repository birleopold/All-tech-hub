[Unit]
Description=Create LEOSOFT alerts for overdue work, payment exceptions, and low stock
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=admin
Group=www-data
WorkingDirectory=/home/admin/All-tech-hub
EnvironmentFile=/home/admin/All-tech-hub/.env
ExecStart=/home/admin/All-tech-hub/.venv/bin/python manage.py monitor_operations
Nice=10
NoNewPrivileges=true
PrivateTmp=true

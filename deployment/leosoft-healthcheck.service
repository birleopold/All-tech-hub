[Unit]
Description=Check LEOSOFT operational health
After=network.target postgresql.service

[Service]
Type=oneshot
User=admin
Group=www-data
WorkingDirectory=/home/admin/All-tech-hub
EnvironmentFile=/home/admin/All-tech-hub/.env
ExecStart=/home/admin/All-tech-hub/.venv/bin/python manage.py check_operational_health --json

[Unit]
Description=LEOSOFT UG LTD Django Gunicorn
After=network.target

[Service]
User=leosoft
Group=www-data
WorkingDirectory=/home/leosoft/All-tech-hub
EnvironmentFile=/home/leosoft/All-tech-hub/.env
ExecStart=/home/leosoft/All-tech-hub/.venv/bin/gunicorn \
  --workers 3 \
  --timeout 120 \
  --bind 127.0.0.1:8010 \
  --access-logfile - \
  --error-logfile - \
  config.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

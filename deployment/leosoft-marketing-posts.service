[Unit]
Description=Run LEOSOFT durable marketing and customer automation
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=admin
Group=www-data
WorkingDirectory=/home/admin/All-tech-hub
EnvironmentFile=/home/admin/All-tech-hub/.env
ExecStart=/home/admin/All-tech-hub/.venv/bin/python manage.py run_automation_jobs --limit 100
Nice=5
NoNewPrivileges=true
PrivateTmp=true
